# Copy this file to .env in the repository root.
# These are development defaults only. Do not put passwords, API keys or tokens here.
SOUL_APP_NAME=SOUL API
SOUL_APP_VERSION=0.1.0
SOUL_ENV=development

# Optional, only for AI-assisted batch annotation of the local prepared SMS dataset.
# Use an OpenAI-compatible chat-completions endpoint. Keep real credentials in .env only.
SOUL_LLM_BASE_URL=
SOUL_LLM_API_KEY=
SOUL_LLM_MODEL=
